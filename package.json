{
  "name": "review-markdown",
  "version": "0.1.0",
  "description": "Local CLI and web app for reviewing Markdown and PDF files, with direct Markdown editing.",
  "type": "module",
  "license": "MIT",
  "author": "maronnjapan",
  "homepage": "https://github.com/maronnjapan/review-markdown-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maronnjapan/review-markdown-cli.git"
  },
  "bugs": {
    "url": "https://github.com/maronnjapan/review-markdown-cli/issues"
  },
  "bin": {
    "review-markdown": "./bin/markdown-review.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "skills/",
    "extension/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node ./bin/markdown-review.js . --no-open",
    "test": "node --test",
    "test:cli": "node --test \"test/*.test.js\"",
    "test:context-api": "node --test \"context-api/test/*.test.js\""
  },
  "keywords": [
    "markdown",
    "pdf",
    "review",
    "cli",
    "zenn",
    "editor",
    "google-meet",
    "captions"
  ],
  "dependencies": {
    "cheerio": "^1.2.0",
    "pdfjs-dist": "6.2.108",
    "zenn-content-css": "^0.5.2",
    "zenn-markdown-html": "^0.5.2"
  },
  "devDependencies": {
    "jsdom": "^30.0.0"
  }
}
